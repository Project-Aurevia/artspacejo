# Copy to .env and adjust. Loaded automatically by npm run dev / npm run serve
# (via node --env-file-if-exists). Never commit the real .env.

# --- admin login -------------------------------------------------------------
# Nothing to set: the owner account (ceo@artspacejo.com) is built into
# server/auth.js and staff are managed in Admin -> Settings -> Users.
# Only `npm run e2e` / scripts/ci.sh need E2E_PASSWORD (the owner password).

# --- required in production -------------------------------------------------
# Canonical public URL: used for canonical tags, sitemap, robots and emails.
SITE_URL=https://www.yourdomain.com

# --- server ----------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=./data
# Set to true (or a hop count) when running behind Caddy/nginx so rate limits
# see the real client IP.
# TRUST_PROXY=true

# --- optional email --------------------------------------------------------
# Without SMTP_* the PDF email button falls back to downloading the PDF and
# opening the mail client. New-request notifications are also skipped.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=quotes@yourdomain.com
# SMTP_PASS=
# MAIL_FROM=Art Space <quotes@yourdomain.com>
# NOTIFY_TO=you@yourdomain.com
